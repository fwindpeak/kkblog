# ==========================================
# Astro 前台与 Vite 后台 API 请求地址
# 本地开发时通常为 http://localhost:4321
# ==========================================
PUBLIC_SERVER_URL=http://localhost:4321
VITE_SERVER_URL=http://localhost:4321
VITE_API_URL=http://localhost:4321

# ==========================================
# 后端与安全配置
# ==========================================
# 管理后台登录密钥
ADMIN_SECRET=123456
# SQLite 数据库文件路径（默认在项目根目录 blog.db）
# DB_PATH=./blog.db

# ==========================================
# 七牛云图床配置 (如果使用图片上传到七牛云)
# ==========================================
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
QINIU_BUCKET=your_qiniu_bucket_name
QINIU_DOMAIN=http://your_qiniu_domain.com