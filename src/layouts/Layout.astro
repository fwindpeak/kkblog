---
import "../globals.css";
import { ClientRouter } from 'astro:transitions';

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
    if (path === "/" && currentPath === "/") return true;
    if (path !== "/" && currentPath.startsWith(path)) return true;
    return false;
};

const navItems = [
    { label: "首页", path: "/" },
    { label: "文章", path: "/blog" },
    { label: "随笔", path: "/thoughts" },
    { label: "工具", path: "/tools" },
];
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} — GK Blog</title>
        <meta name="description" content="收集片刻，于静止与喧嚣之中。个人数字工作室与独立写作空间。" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

        <ClientRouter />

        <!-- Theme initialization script (blocking to prevent FOUC flash) -->
        <script is:inline>
            function applyTheme() {
                const storedTheme = localStorage.getItem('theme');
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const theme = storedTheme || (systemDark ? 'dark' : 'light');
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.remove('light');
                } else {
                    document.documentElement.classList.add('light');
                    document.documentElement.classList.remove('dark');
                }
            }
            applyTheme();
            document.addEventListener('astro:after-swap', applyTheme);
        </script>
    </head>
    <body class="min-h-screen flex flex-col bg-white dark:bg-[#09090b] text-slate-900 dark:text-zinc-100">
        <!-- Clean Modern Header (Persisted across client-side page transitions) -->
        <header transition:persist class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/90 dark:bg-[#09090b]/90 border-b border-slate-200/80 dark:border-zinc-800">
            <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
                <!-- Brand / Logo -->
                <a href="/" class="group flex items-center gap-3 no-underline text-slate-900 dark:text-zinc-100 shrink-0">
                    <img
                        src="/img/profile.png"
                        alt="GK"
                        width="32"
                        height="32"
                        class="w-8 h-8 rounded-full object-cover shrink-0 ring-1 ring-slate-200 dark:ring-zinc-700 group-hover:scale-105 transition-transform"
                    />
                    <div class="flex items-baseline gap-1.5 shrink-0">
                        <span class="font-bold text-base tracking-tight text-slate-900 dark:text-white">
                            GK
                        </span>
                        <span class="text-xs text-slate-500 dark:text-zinc-400 font-mono">
                            / Studio
                        </span>
                    </div>
                </a>

                <!-- Nav & Controls -->
                <div class="flex items-center space-x-4 sm:space-x-6">
                    <!-- Desktop Navigation (fixed height and padding to eliminate shifts) -->
                    <nav class="hidden sm:flex items-center space-x-1 text-sm font-medium">
                        {navItems.map((item) => {
                            const active = isActive(item.path);
                            return (
                                <a
                                    href={item.path}
                                    data-nav-item
                                    data-path={item.path}
                                    class={`nav-link relative px-3 py-1.5 rounded-lg transition-colors ${
                                        active
                                            ? "text-slate-900 dark:text-white"
                                            : "text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 hover:bg-slate-100/60 dark:hover:bg-zinc-800/50"
                                    }`}
                                >
                                    <span>{item.label}</span>
                                    <span class={`nav-indicator absolute bottom-0 left-3 right-3 h-[2px] bg-slate-900 dark:bg-white rounded-full ${active ? "" : "hidden"}`}></span>
                                </a>
                            );
                        })}
                    </nav>

                    <!-- Theme Toggle Button (strictly locked width & height, pure CSS icon display) -->
                    <button
                        type="button"
                        id="theme-toggle"
                        class="w-8 h-8 flex items-center justify-center shrink-0 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
                        aria-label="切换明暗主题"
                        title="切换主题"
                    >
                        <!-- Sun Icon (visible only in dark mode via CSS) -->
                        <svg class="hidden dark:block w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <!-- Moon Icon (visible only in light mode via CSS) -->
                        <svg class="block dark:hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                        </svg>
                    </button>

                    <!-- Mobile Menu Button -->
                    <div class="sm:hidden flex items-center">
                        <button
                            type="button"
                            id="mobile-menu-button"
                            class="w-8 h-8 flex items-center justify-center shrink-0 text-slate-600 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 focus:outline-none"
                            aria-label="Toggle menu"
                        >
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Dropdown Menu -->
            <div id="mobile-menu" class="hidden sm:hidden bg-white dark:bg-[#09090b] border-b border-slate-200 dark:border-zinc-800 px-6 py-4 space-y-2">
                {navItems.map((item) => {
                    const active = isActive(item.path);
                    return (
                        <a
                            href={item.path}
                            data-mobile-nav-item
                            data-path={item.path}
                            class={`mobile-nav-link block py-1.5 px-3 rounded-md text-base font-medium ${
                                active
                                    ? "text-slate-900 dark:text-white bg-slate-100 dark:bg-zinc-800"
                                    : "text-slate-500 dark:text-zinc-400 hover:bg-slate-50 dark:hover:bg-zinc-800/50"
                            }`}
                        >
                            {item.label}
                        </a>
                    );
                })}
            </div>
        </header>

        <!-- Main Workspace -->
        <main class="flex-grow w-full max-w-4xl mx-auto px-6 py-10 md:py-14">
            <slot />
        </main>

        <!-- Clean Modern Footer -->
        <footer class="mt-auto border-t border-slate-200/80 dark:border-zinc-800/80 py-10">
            <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-baseline justify-between gap-6 text-sm text-slate-500 dark:text-zinc-400">
                <div class="space-y-1">
                    <p class="font-medium text-slate-800 dark:text-zinc-200 text-sm">
                        收集片刻，于静止与喧嚣之中。
                    </p>
                    <p class="text-xs text-slate-500 dark:text-zinc-400 font-mono">
                        © {new Date().getFullYear()} GK. Built with Astro & Tailwind.
                    </p>
                </div>
                <div class="flex items-center gap-6 text-xs font-mono tracking-wider">
                    <a href="/blog" class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">文章</a>
                    <a href="/thoughts" class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">随笔</a>
                    <a href="/tools" class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors">工具</a>
                    <a href="https://github.com/fwindpeak" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-1">
                        GitHub
                        <span class="opacity-60 text-[10px]">↗</span>
                    </a>
                </div>
            </div>
        </footer>

        <script>
            import mediumZoom from "medium-zoom";

            function updateActiveNav() {
                const current = window.location.pathname;

                // Sync desktop nav active indicator and text colors
                document.querySelectorAll('[data-nav-item]').forEach((el) => {
                    const path = el.getAttribute('data-path');
                    const isCurrent = path === '/' ? current === '/' : (path && current.startsWith(path));
                    const indicator = el.querySelector('.nav-indicator');

                    if (isCurrent) {
                        el.classList.add('text-slate-900', 'dark:text-white');
                        el.classList.remove('text-slate-500', 'dark:text-zinc-400');
                        indicator?.classList.remove('hidden');
                    } else {
                        el.classList.remove('text-slate-900', 'dark:text-white');
                        el.classList.add('text-slate-500', 'dark:text-zinc-400');
                        indicator?.classList.add('hidden');
                    }
                });

                // Sync mobile nav
                document.querySelectorAll('[data-mobile-nav-item]').forEach((el) => {
                    const path = el.getAttribute('data-path');
                    const isCurrent = path === '/' ? current === '/' : (path && current.startsWith(path));
                    if (isCurrent) {
                        el.classList.add('text-slate-900', 'dark:text-white', 'bg-slate-100', 'dark:bg-zinc-800');
                        el.classList.remove('text-slate-500', 'dark:text-zinc-400');
                    } else {
                        el.classList.remove('text-slate-900', 'dark:text-white', 'bg-slate-100', 'dark:bg-zinc-800');
                        el.classList.add('text-slate-500', 'dark:text-zinc-400');
                    }
                });
            }

            function setupPageInteractions() {
                updateActiveNav();

                // Initialize zoom
                mediumZoom(".zoomable-image", {
                    margin: 32,
                    background: document.documentElement.classList.contains("dark") ? "rgba(9, 9, 11, 0.95)" : "rgba(255, 255, 255, 0.95)",
                });

                // Theme Switcher Toggle Click
                const themeToggleBtn = document.getElementById('theme-toggle');
                if (themeToggleBtn && !themeToggleBtn.dataset.bound) {
                    themeToggleBtn.dataset.bound = 'true';
                    themeToggleBtn.addEventListener('click', () => {
                        const isDark = document.documentElement.classList.contains('dark');
                        if (isDark) {
                            document.documentElement.classList.remove('dark');
                            document.documentElement.classList.add('light');
                            localStorage.setItem('theme', 'light');
                        } else {
                            document.documentElement.classList.add('dark');
                            document.documentElement.classList.remove('light');
                            localStorage.setItem('theme', 'dark');
                        }
                    });
                }

                // Mobile Menu Toggle
                const button = document.getElementById("mobile-menu-button");
                const menu = document.getElementById("mobile-menu");
                const iconOpen = document.getElementById("menu-icon-open");
                const iconClose = document.getElementById("menu-icon-close");

                if (button && menu && !button.dataset.bound) {
                    button.dataset.bound = 'true';
                    button.addEventListener("click", () => {
                        menu.classList.toggle("hidden");
                        iconOpen?.classList.toggle("hidden");
                        iconClose?.classList.toggle("hidden");
                    });
                }

                // Page view tracking
                try {
                    fetch("/api/track", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            path: window.location.pathname,
                        }),
                    });
                } catch (e) {
                    // silent
                }
            }

            document.addEventListener("DOMContentLoaded", setupPageInteractions);
            document.addEventListener("astro:page-load", setupPageInteractions);
        </script>
    </body>
</html>
