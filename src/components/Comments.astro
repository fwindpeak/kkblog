---
// src/components/Comments.astro
interface Props {
  id: string | number;
  type: 'post' | 'thought';
}

const { id, type } = Astro.props;
---

<comment-widget data-id={id} data-type={type} class="block">
  <details class="group">
    <summary class="cursor-pointer font-medium text-slate-800 dark:text-zinc-200 flex items-center gap-2 mb-4 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors outline-none select-none">
      <span class="text-sm font-semibold">讨论与留言</span>
      <span class="text-xs bg-slate-100 dark:bg-zinc-800 px-2 py-0.5 rounded-full text-slate-600 dark:text-zinc-300 font-mono comment-count">0</span>
    </summary>
    
    <div class="mt-4 space-y-6">
      <!-- 评论列表 -->
      <div class="comments-list space-y-4">
        <p class="text-slate-400 dark:text-zinc-500 text-xs italic">正在载入讨论...</p>
      </div>

      <!-- 评论表单 -->
      <div class="comment-form bg-slate-50 dark:bg-zinc-900/60 p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800">
        <div class="space-y-3">
          <input 
            type="text" 
            class="comment-author w-full px-3 py-2 text-sm bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-700 rounded-lg focus:outline-none focus:border-slate-400 dark:focus:border-zinc-500 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-zinc-500"
            placeholder="你的昵称（选填）" 
          />
          <textarea 
            class="comment-content w-full px-3 py-2 text-sm bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-700 rounded-lg focus:outline-none focus:border-slate-400 dark:focus:border-zinc-500 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-zinc-500"
            rows="3" 
            placeholder="写下你的想法或讨论..." 
          ></textarea>
          <div class="flex justify-end">
            <button class="submit-comment px-4 py-1.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-medium rounded-lg hover:bg-slate-800 dark:hover:bg-zinc-100 transition-colors cursor-pointer disabled:opacity-50">
              发送
            </button>
          </div>
        </div>
      </div>
    </div>
  </details>
</comment-widget>

<script>
  import { formatDateTime } from '../lib/utils';

  class CommentWidget extends HTMLElement {
    connectedCallback() {
      const id = this.dataset.id;
      const type = this.dataset.type;
      const list = this.querySelector('.comments-list');
      const authorInput = this.querySelector('.comment-author') as HTMLInputElement;
      const contentInput = this.querySelector('.comment-content') as HTMLTextAreaElement;
      const submitBtn = this.querySelector('.submit-comment') as HTMLButtonElement;
      const countBadge = this.querySelector('.comment-count');

      const loadComments = async () => {
        try {
          const res = await fetch(`/api/comments?id=${id}&type=${type}`);
          const comments = await res.json();
          
          if (countBadge) countBadge.textContent = comments.length.toString();

          if (comments.length === 0) {
            list!.innerHTML = '<p class="text-slate-400 dark:text-zinc-500 text-xs italic">暂无留言，欢迎留下第一条评论。</p>';
            return;
          }

          list!.innerHTML = comments.map((c: any) => `
            <div class="comment-item text-sm border-b border-slate-100 dark:border-zinc-800 pb-3 last:border-b-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-semibold text-slate-900 dark:text-white">${c.author}</span>
                <span class="text-xs text-slate-400 dark:text-zinc-500 font-mono">${formatDateTime(c.created_at)}</span>
              </div>
              <p class="text-slate-700 dark:text-zinc-300 leading-relaxed">${c.content}</p>
            </div>
          `).join('');
        } catch (e) {
          list!.innerHTML = '<p class="text-red-400 text-xs">加载评论失败</p>';
        }
      };

      loadComments();

      if (submitBtn) {
        submitBtn.addEventListener('click', async () => {
          const author = authorInput.value.trim() || '匿名读者';
          const content = contentInput.value.trim();

          if (!content) {
            alert('请输入评论内容');
            return;
          }

          submitBtn.disabled = true;
          submitBtn.innerText = '发送中...';

          try {
            const res = await fetch('/api/comment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                author,
                content,
                target_id: id,
                target_type: type,
              }),
            });

            if (res.ok) {
              contentInput.value = '';
              loadComments();
            } else {
              alert('提交失败，请重试');
            }
          } catch (e) {
            alert('网络异常');
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = '发送';
          }
        });
      }
    }
  }

  customElements.define('comment-widget', CommentWidget);
</script>
