---
// src/components/LikeButton.astro
interface Props {
  id: string | number;
  type: 'post' | 'thought';
  initialLikes?: number;
}

const { id, type, initialLikes = 0 } = Astro.props;
---

<div class="like-container flex items-center gap-2 mt-4">
  <button 
    class="like-btn flex items-center gap-2 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-pink-100 hover:text-pink-600 transition-colors cursor-pointer text-sm"
    data-id={id} 
    data-type={type}
  >
    <span class="heart-icon">❤️</span>
    <span class="like-count">{initialLikes}</span>
  </button>
</div>

<script>
  const buttons = document.querySelectorAll('.like-btn');
  // Use relative URL so it works on any domain and port
  const serverUrl = '';

  // 动态获取最新的点赞数
  const fetchLikes = async () => {
    const typeMap = new Map();
    buttons.forEach(btn => {
      const type = btn.getAttribute('data-type');
      const id = btn.getAttribute('data-id');
      if (type && id) {
        if (!typeMap.has(type)) typeMap.set(type, new Set());
        typeMap.get(type).add(id);
      }
    });

    for (const [type, idsSet] of typeMap.entries()) {
      const ids = Array.from(idsSet).join(',');
      if (!ids) continue;
      try {
        const res = await fetch(`${serverUrl}/api/likes?type=${type}&ids=${ids}`);
        if (!res.ok) continue;
        const likesMap = await res.json();
        
        buttons.forEach(btn => {
          if (btn.getAttribute('data-type') === type) {
            const id = btn.getAttribute('data-id');
            if (id && likesMap[id] !== undefined) {
              const countSpan = btn.querySelector('.like-count');
              if (countSpan) countSpan.textContent = likesMap[id].toString();
            }
          }
        });
      } catch (e) {
        console.error('Failed to fetch likes:', e);
      }
    }
  };

  // 页面加载时获取最新点赞数
  fetchLikes();

  buttons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const type = btn.getAttribute('data-type');
      const countSpan = btn.querySelector('.like-count');
      
      try {
        const res = await fetch(`${serverUrl}/api/like`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, id })
        });
        
        if (res.ok && countSpan) {
          const current = parseInt(countSpan.textContent || '0');
          countSpan.textContent = (current + 1).toString();
          btn.classList.add('text-pink-600', 'bg-pink-50');
        }
      } catch (e) {
        console.error('Like failed:', e);
      }
    });
  });
</script>