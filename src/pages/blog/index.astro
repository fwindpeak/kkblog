---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';

export const prerender = true;

// Directly query database during build time
const rawPosts = db.query("SELECT * FROM posts ORDER BY created_at DESC").all();
const posts = rawPosts.map((p: any) => ({
    ...p,
    tags: p.tags ? JSON.parse(p.tags) : []
}));
---

<Layout title="文章列表">
    <div class="space-y-10">
        <!-- Header -->
        <header class="border-b border-slate-200/80 dark:border-zinc-800 pb-6">
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                文章
            </h1>
            <p class="text-sm text-slate-500 dark:text-zinc-400">
                记录长篇技术思考、系统架构经验与工具设计背后的历程。共 {posts.length} 篇。
            </p>
        </header>

        <!-- Articles Catalog -->
        <div class="divide-y divide-slate-100 dark:divide-zinc-800/80">
            {posts.map((post: any) => (
                <article class="group py-7 first:pt-0">
                    <div class="space-y-2.5">
                        <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-zinc-400">
                            <time>{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
                            <span>·</span>
                            <span>{post.read_time || "1"} 分钟阅读</span>
                        </div>
                        
                        <h2 class="text-xl sm:text-2xl font-semibold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors leading-snug">
                            <a href={`/blog/${post.slug}`} class="no-underline">{post.title}</a>
                        </h2>
                        
                        {post.excerpt && (
                            <p class="text-slate-600 dark:text-zinc-300 text-sm sm:text-base leading-relaxed line-clamp-3">
                                {post.excerpt}
                            </p>
                        )}
                        
                        {post.tags && post.tags.length > 0 && (
                            <div class="flex flex-wrap gap-2 pt-1">
                                {post.tags.map((tag: string) => (
                                    <span class="text-xs text-slate-600 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-800/80 px-2 py-0.5 rounded-md font-mono">
                                        #{tag}
                                    </span>
                                ))}
                            </div>
                        )}
                    </div>
                </article>
            ))}
        </div>
    </div>
</Layout>
