---
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';
import { marked } from '../../lib/markedSetup';
import { db } from '../../lib/db';

export const prerender = true;

export async function getStaticPaths() {
    const posts = db.query("SELECT * FROM posts ORDER BY created_at DESC").all().map((p: any) => ({
        ...p,
        tags: p.tags ? JSON.parse(p.tags) : []
    }));
    
    return posts.map((post: any) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const contentHtml = await marked.parse(post.content);
---

<Layout title={post.title}>
    <div class="space-y-8">
        <!-- Back link -->
        <div>
            <a
                href="/blog"
                class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-white transition-colors no-underline font-medium"
            >
                ← 返回文章列表
            </a>
        </div>
       
        <article class="max-w-2xl mx-auto space-y-6">
            <header class="space-y-3 border-b border-slate-200/80 dark:border-zinc-800 pb-6">
                <div class="flex items-center gap-3 text-xs font-mono text-slate-500 dark:text-zinc-400">
                    <time>{new Date(post.created_at).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
                    <span>·</span>
                    <span>{post.read_time || "1"} 分钟阅读</span>
                    {post.tags && post.tags.length > 0 && (
                        <>
                            <span>·</span>
                            <div class="flex gap-1.5">
                                {post.tags.map((tag: string) => (
                                    <span class="text-slate-600 dark:text-zinc-300">#{tag}</span>
                                ))}
                            </div>
                        </>
                    )}
                </div>
                
                <h1 class="text-2xl sm:text-3xl md:text-[2.2rem] font-bold text-slate-900 dark:text-white leading-tight">
                    {post.title}
                </h1>
            </header>

            <div class="prose text-slate-800 dark:text-zinc-200" set:html={contentHtml} />
            
            <div class="mt-14 pt-8 border-t border-slate-200/80 dark:border-zinc-800">
                <div class="py-2">
                    <Comments id={post.id} type="post" />
                </div>
            </div>
        </article>
    </div>
</Layout>
