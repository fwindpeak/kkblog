    category: "imaging",
    categoryLabel: "影像摄影"
  },

  // 复古计算
  {
    id: "lavstudio",
    name: "LavStudio",
    title: "网页版 LavaX IDE 与编辑器",
    description: "文曲星经典开发语言 LavaX 的现代 Web 集成开发环境，支持在线代码编写、一键编译、反编译与高亮预览。",
    url: "https://fwindpeak.github.io/LavStudio/",
    github: "https://github.com/fwindpeak/LavStudio",
    icon: "💻",
    category: "retro",
    categoryLabel: "复古计算"
  },
  {
    id: "nc2000-wasm",
    name: "NC2000-wasm",
    title: "文曲星 NC2000 网页版模拟器",
    description: "采用 WebAssembly 技术在现代浏览器中高保真模拟经典文曲星 NC2000 电子词典，重温童年黑白点阵情怀。",
    url: "https://fwindpeak.github.io/NC2000-wasm/",
    github: "https://github.com/fwindpeak/NC2000-wasm",
    icon: "📟",
    category: "retro",
    categoryLabel: "复古计算"
  },

  // 创意视觉
  {
    id: "wordcloud",
    name: "wordcloud-demo",
    title: "纯前端词云图片生成器",
    description: "零后端依赖的文字词云艺术图片生成工具，支持自定义形状蒙版、词频权重分配、定制配色与高清图片导出。",
    url: "https://word.pages.dev",
    github: "https://github.com/fwindpeak/wordcloud-demo",
    icon: "☁️",
    category: "creative",
    categoryLabel: "创意视觉"
  },
  {
    id: "ar-model-viewer",
    name: "ar-model-viewer",
    title: "3D / AR 虚拟模型查看器",
