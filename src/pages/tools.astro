    categoryLabel: "游戏与VR"
  },
  {
    id: "quest-store-query",
    name: "oculus-quest-store-query",
    title: "Quest 商店折扣动态查询",
    description: "实时跟踪与查询 Meta Quest 官方商店的游戏特惠打折信息，获取第一手降价动态与历史价格参考。",
    url: "https://fwindpeak.github.io/oculus-quest-store-query/",
    github: "https://github.com/fwindpeak/oculus-quest-store-query",
    icon: "🏷️",
    category: "games",
    categoryLabel: "游戏与VR"
  },
  {
    id: "vite-tetris",
    name: "vite-tetris",
    title: "复古掌机俄罗斯方块",
    description: "基于 React、Redux、Immutable 与 Vite 构建的复古像素掌机俄罗斯方块，还原经典声效与纯粹手感。",
    url: "https://fwindpeak.github.io/vite-tetris/",
    github: "https://github.com/fwindpeak/vite-tetris",
    icon: "🕹️",
    category: "games",
    categoryLabel: "游戏与VR"
  }
];

const categories = [
  { key: 'all', label: '全部项目' },
  { key: 'imaging', label: '影像摄影' },
  { key: 'retro', label: '复古计算' },
  { key: 'creative', label: '创意视觉' },
  { key: 'games', label: '游戏与VR' },
];
---

<Layout title="工坊与工具">
    <div class="space-y-8">
        <!-- 头部标题区 -->
        <header class="border-b border-slate-200/80 dark:border-zinc-800 pb-6">
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                工坊与工具
            </h1>
            <p class="text-sm text-slate-500 dark:text-zinc-400">
                独立开发、实验性探索与影像计算工具，浏览器中即开即用。共 {tools.length} 个作品。
            </p>

            <!-- 分类筛选器 -->
            <div class="mt-6 flex flex-wrap gap-2" id="category-filter">
                {categories.map((cat, idx) => (
                    <button
                        type="button"
                        data-category={cat.key}
                        class={`filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer ${
                            idx === 0
                                ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xs'
                                : 'bg-slate-100 text-slate-600 hover:text-slate-900 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:text-white hover:bg-slate-200/70 dark:hover:bg-zinc-700'
                        }`}
                    >
                        {cat.label}
                    </button>
                ))}
            </div>
        </header>

        <!-- 工具网格列表 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5" id="tools-grid">
            {tools.map((tool, index) => (
                <div
                    data-category={tool.category}
                    class="tool-card group p-5 sm:p-6 rounded-xl border border-slate-200/80 dark:border-zinc-800 bg-slate-50/40 hover:bg-white dark:bg-zinc-900/40 dark:hover:bg-zinc-900/80 hover:border-slate-300 dark:hover:border-zinc-700 transition-all flex flex-col justify-between"
                >
                    <div class="space-y-3">
                        <!-- 卡片顶部 -->
                        <div class="flex items-center justify-between gap-3 text-xs font-mono">
                            <span class="text-slate-400 dark:text-zinc-500">
                                #{String(index + 1).padStart(2, '0')}
                            </span>
                            <span class="text-xs font-medium text-slate-500 dark:text-zinc-400">
                                {tool.categoryLabel}
                            </span>
                        </div>

                        <!-- 标题与英文名 -->
                        <div>
                            <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-white leading-snug">
                                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="no-underline hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                                    {tool.title}
                                </a>
                            </h2>
                            <span class="text-xs font-mono text-slate-400 dark:text-zinc-500 block mt-0.5">
                                {tool.name}
                            </span>
                        </div>

                        <!-- 描述 -->
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-300 leading-relaxed">
                            {tool.description}
                        </p>
                    </div>

                    <!-- 底部操作与链接 -->
                    <div class="pt-4 mt-3 border-t border-slate-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
                        {tool.github ? (
                            <a
                                href={tool.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-slate-400 hover:text-slate-700 dark:hover:text-zinc-200 transition-colors inline-flex items-center gap-1 no-underline font-mono"
                            >
                                Source ↗
                            </a>
                        ) : <span />}

                        <a
                            href={tool.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-slate-900 dark:text-white hover:text-sky-600 dark:hover:text-sky-400 transition-colors no-underline font-medium"
                        >
                            <span>启动体验</span>
                            <span class="text-xs transition-transform group-hover:translate-x-0.5">↗</span>
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- 客户端分类筛选脚本 -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filterContainer = document.getElementById('category-filter');
            const cards = document.querySelectorAll<HTMLElement>('.tool-card');
            if (!filterContainer) return;

            const buttons = filterContainer.querySelectorAll<HTMLButtonElement>('.filter-btn');

            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const category = btn.getAttribute('data-category');

                    buttons.forEach(b => {
                        b.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer bg-slate-100 text-slate-600 hover:text-slate-900 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:text-white hover:bg-slate-200/70 dark:hover:bg-zinc-700';
                    });
                    btn.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all cursor-pointer bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xs';

                    cards.forEach(card => {
                        const cardCat = card.getAttribute('data-category');
                        if (category === 'all' || cardCat === category) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
</Layout>
