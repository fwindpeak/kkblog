---
import Layout from "../layouts/Layout.astro";
import ThoughtsBoard from "../components/ThoughtsBoard.vue";
import { marked } from "../lib/markedSetup";
import { db } from "../lib/db";

export const prerender = false;

const rawThoughts = db
    .query("SELECT * FROM thoughts ORDER BY created_at DESC")
    .all();

const processedThoughts = await Promise.all(
    rawThoughts.map(async (t: any) => ({
        ...t,
        html: await marked.parse(t.content),
    })),
);
---

<Layout title="随笔与瞬息念头">
    <ThoughtsBoard client:load initialThoughts={processedThoughts} />
</Layout>
