---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import LikeButton from '../components/LikeButton.astro';
import { db } from '../lib/db';
import { formatDateTime } from '../lib/utils';

export const prerender = true;

const thoughts = db.query("SELECT * FROM thoughts ORDER BY created_at DESC").all();

// 预处理 Markdown，Astro 支持在 Frontmatter 写顶层 await
const processedThoughts = await Promise.all(thoughts.map(async (t: any) => ({
    ...t,
    html: await marked.parse(t.content)
})));

const moodMap: Record<string, string> = {
    'neutral': '平静',
    'happy': '愉快',
    'pensive': '沉思',
    'excited': '兴奋'
};
---

<Layout title="随笔">
    <div class="animate-in fade-in slide-in-from-bottom-4 duration-500 relative z-10 w-full">
        <div class="flex justify-between items-baseline border-b border-gray-200 dark:border-gray-800 pb-4 mb-8 max-w-2xl mx-auto mt-0">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white m-0">瞬息念头</h2>
        </div>
        
        <div class="max-w-2xl mx-auto space-y-6">
            {processedThoughts.map((thought) => (
                <div class="bg-white dark:bg-[#1b1b1d] p-5 sm:p-6 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800">
                    
                    <div class="flex items-center gap-3 mb-4">
                        <img src="/img/profile.png" alt="Avatar" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700" />
                        <div>
                            <div class="font-bold text-sm text-gray-900 dark:text-gray-100">GK</div>
                            <div class="text-xs text-gray-500 dark:text-gray-400 flex gap-2 items-center">
                                <span>{formatDateTime(thought.created_at)}</span>
                                {thought.mood && (
                                    <span class="opacity-75 bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded text-[10px]">
                                        {moodMap[thought.mood] || thought.mood}
                                    </span>
                                )}
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-base text-gray-800 dark:text-gray-200 leading-relaxed prose dark:prose-invert prose-p:my-2 prose-img:rounded-lg prose-img:border prose-img:border-gray-100 dark:prose-img:border-gray-800" set:html={thought.html} />
                    
                    <div class="mt-4 flex justify-end items-center border-t border-gray-100 dark:border-gray-800 pt-3">
                        <LikeButton id={thought.id} type="thought" initialLikes={thought.likes} />
                    </div>
                </div>
            ))}
        </div>
    </div>
</Layout>