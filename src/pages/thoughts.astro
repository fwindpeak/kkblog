---
import Layout from '../layouts/Layout.astro';
import { marked } from '../lib/markedSetup';
import LikeButton from '../components/LikeButton.astro';
import Comments from '../components/Comments.astro';
import { db } from '../lib/db';
import { formatDateTime } from '../lib/utils';

export const prerender = true;

const thoughts = db.query("SELECT * FROM thoughts ORDER BY created_at DESC").all();

// 预处理 Markdown，Astro 支持在 Frontmatter 写顶层 await
const processedThoughts = await Promise.all(thoughts.map(async (t: any) => ({
    ...t,
    html: await marked.parse(t.content)
})));

const moodMap: Record<string, string> = {
    'neutral': '平静',
    'happy': '愉快',
    'pensive': '沉思',
    'excited': '兴奋'
};
---

<Layout title="随笔">
    <div class="animate-in fade-in slide-in-from-bottom-4 duration-500 relative z-10 w-full">
        <div class="flex justify-between items-baseline border-b border-gray-200 dark:border-gray-800 pb-4 mb-8 max-w-2xl mx-auto mt-0">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white m-0">瞬息念头</h2>
        </div>
        
        <div class="max-w-2xl mx-auto">
            {processedThoughts.map((thought) => (
                <article class="flex gap-4 py-8 border-b border-gray-100 dark:border-gray-800/60 last:border-0">
                    {/* Avatar Column */}
                    <div class="flex-shrink-0">
                        <img src="/img/profile.png" alt="Avatar" class="w-12 h-12 rounded-full shadow-sm border border-gray-200 dark:border-gray-700" />
                    </div>
                    
                    {/* Content Column */}
                    <div class="flex-grow min-w-0">
                        {/* Header: Name */}
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-bold text-[15px] text-gray-900 dark:text-gray-100">GK</span>
                        </div>
                        
                        {/* Text Content */}
                        <div class="text-[15px] text-gray-800 dark:text-gray-200 leading-relaxed prose dark:prose-invert prose-p:mt-0 prose-p:mb-2 last:prose-p:mb-0 prose-img:rounded-xl prose-img:border prose-img:border-gray-100 dark:prose-img:border-gray-800 prose-img:mt-2" set:html={thought.html} />
                        
                        {/* Actions Row */}
                        <div class="mt-3 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                            <div class="flex items-center gap-3">
                                <span>{formatDateTime(thought.created_at)}</span>
                                {thought.mood && (
                                    <span class="flex items-center gap-1 opacity-80 bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded text-[10px]">
                                        {moodMap[thought.mood] || thought.mood}
                                    </span>
                                )}
                            </div>
                            <LikeButton id={thought.id} type="thought" initialLikes={thought.likes} />
                        </div>
                        
                        {/* Comments Section */}
                        <div class="mt-4 bg-gray-50/50 dark:bg-[#1b1b1d]/50 rounded-xl p-3 pb-0">
                            <Comments id={thought.id} type="thought" />
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</Layout>